{
  "name": "@letdraw/sdk",
  "version": "0.1.0",
  "description": "Typed REST client for the LetDraw public API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letdraw/letdraw-mcp.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.letdraw.com/en/reference/mcp-api/",
  "bugs": {
    "url": "https://github.com/letdraw/letdraw-mcp/issues"
  },
  "keywords": [
    "letdraw",
    "diagram",
    "whiteboard",
    "rest",
    "sdk",
    "api",
    "diagrams-as-code",
    "architecture-diagram"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.4"
  }
}
